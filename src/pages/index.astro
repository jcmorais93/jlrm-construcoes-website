---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ObraCard from '../components/ObraCard.astro';
import { site } from '../config/site';
import { organizationLd } from '../lib/jsonld';
import { assertNoDemo } from '../lib/demo';
const siteUrl = Astro.site!.origin;
const todas = (await getCollection('obras')).sort((a, b) => a.data.tipo.localeCompare(b.data.tipo));
const cons = todas.filter((o) => o.data.tipo === 'construcao');
const rem = todas.filter((o) => o.data.tipo === 'remodelacao');
const obras = [cons[0], cons[1], rem[0]].filter(Boolean);
assertNoDemo(obras.some((o) => o.data.demo), '/');
const hero = cons[0].data;
---
<Base
  title="Construção civil em Felgueiras | JLRM Construções"
  description="Construção de moradias e remodelações em Felgueiras. Empreiteiro com alvará de obras particulares. Peça orçamento."
  jsonLd={[organizationLd(siteUrl)]}
>
  <div class="hero">
    <div class="wrap">
      <div class="hero-grid">
        <div>
          <p class="label" style="margin-bottom:1.25rem">Construção civil · Felgueiras</p>
          <h1>Casas construídas e remodeladas com rigor.</h1>
          <p class="lead">Construímos moradias e remodelamos casas em Felgueiras, com acompanhamento próximo do primeiro dia à entrega da obra.</p>
          <div class="actions">
            <a class="btn" href="/contactos">Pedir orçamento</a>
            <a class="btn secondary" href="/obras">Ver obras</a>
            {site.contact.phoneHref && <a class="btn secondary" href={site.contact.phoneHref}>Ligar</a>}
          </div>
        </div>
        <figure class="plate" style="margin:0">
          <img src={hero.image} alt={hero.alt} width="1200" height="800" fetchpriority="high" />
          <figcaption class="label"><span>{hero.title}</span><span>Demonstração</span></figcaption>
        </figure>
      </div>
      <div class="facts-strip">
        <div><span class="label">Alvará</span><strong>{site.legal.alvara}</strong></div>
        <div><span class="label">Classe</span><strong>{site.legal.alvaraClasse}</strong></div>
        <div><span class="label">Obras</span><strong>Particulares</strong></div>
        <div><span class="label">Sede</span><strong>Felgueiras</strong></div>
      </div>
    </div>
  </div>

  <section>
    <div class="wrap">
      <div class="sec-head"><span class="label">01</span><h2>O que fazemos</h2></div>
      <div class="rows">
        <div class="row">
          <span class="label">A</span>
          <h3>Construção de moradias</h3>
          <p>Da preparação do terreno aos acabamentos, com orçamento detalhado e um único interlocutor.</p>
          <a class="go" href="/servicos/construcao-de-moradias">Construção de moradias →</a>
        </div>
        <div class="row">
          <span class="label">B</span>
          <h3>Remodelações</h3>
          <p>Interiores, fachadas, coberturas e ampliações, planeadas para reduzir surpresas.</p>
          <a class="go" href="/servicos/remodelacoes">Remodelações →</a>
        </div>
      </div>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap">
      <div class="sec-head"><span class="label">02</span><h2>Obras recentes</h2></div>
      <div class="obras-grid three">{obras.map((o, i) => <ObraCard obra={o} index={i} />)}</div>
      <div class="actions"><a class="btn secondary" href="/obras">Todas as obras</a></div>
    </div>
  </section>

  <section style="background:var(--concrete)">
    <div class="wrap">
      <div class="sec-head" style="border-color:var(--ink)"><span class="label">03</span><h2>Quem somos</h2></div>
      <div class="two">
        <div>
          <p class="statement">{site.name} é uma empresa de construção civil sediada em Felgueiras, com alvará de empreiteiro de obras particulares.</p>
          <p style="margin-top:1.5rem"><span class="todo">[PREENCHER: história da empresa, equipa, valores e há quantos anos atua]</span></p>
        </div>
        <dl class="facts">
          <div><dt>Alvará</dt><dd>{site.legal.alvara}</dd></div>
          <div><dt>Classe</dt><dd>{site.legal.alvaraClasse}</dd></div>
          <div><dt>NIF</dt><dd>{site.legal.nif}</dd></div>
          <div><dt>Sede</dt><dd>Felgueiras</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="wrap">
      <h2>Tem uma obra em mente?</h2>
      <p>Fale connosco. Vamos ver o local e damos-lhe um orçamento por escrito.</p>
      <div class="actions"><a class="btn" href="/contactos">Pedir orçamento</a></div>
    </div>
  </section>
</Base>
