---
import { u, siteRoot } from '../../lib/url';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { breadcrumbLd } from '../../lib/jsonld';
import { assertNoDemo } from '../../lib/demo';
export async function getStaticPaths() {
  const obras = await getCollection('obras');
  return obras.map((obra) => ({ params: { slug: obra.id }, props: { obra } }));
}
const { obra } = Astro.props;
const d = obra.data;
assertNoDemo(d.demo, `/obras/${obra.id}`);
const { Content } = await render(obra);
const siteUrl = siteRoot(Astro.site!);
---
<Base
  title={`${d.title} | JLRM Construções`}
  description={d.summary}
  jsonLd={[breadcrumbLd(siteUrl, [{ name: 'Obras', path: '/obras' }, { name: d.title, path: `/obras/${obra.id}` }])]}
>
  <div class="page-head"><div class="wrap">
    <p class="crumbs"><a href={u('/')}>Início</a> / <a href={u('/obras')}>Obras</a> / {d.title}</p>
    <h1>{d.title}</h1>
    <p class="label" style="margin-top:1rem">{d.tipo === 'construcao' ? 'Construção' : 'Remodelação'} · {d.local} {d.demo && <span class="badge">Demonstração</span>}</p>
  </div></div>
  <div class="page-body"><div class="wrap">
    <figure class="plate" style="margin:0 0 2.5rem"><img src={u(d.image)} alt={d.alt} width="1200" height="800" fetchpriority="high" /></figure>
    <div class="prose"><Content /></div>
    <div class="actions">
      <a class="btn" href={u('/contactos')}>Pedir orçamento para uma obra semelhante</a>
      <a class="btn secondary" href={u('/obras')}>Ver mais obras</a>
    </div>
  </div></div>
</Base>
