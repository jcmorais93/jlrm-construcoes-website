---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ObraCard from '../../components/ObraCard.astro';
import { breadcrumbLd } from '../../lib/jsonld';
import { assertNoDemo } from '../../lib/demo';
const obras = await getCollection('obras');
assertNoDemo(obras.some((o) => o.data.demo), '/obras');
const siteUrl = Astro.site!.origin;
---
<Base
  title="Obras de construção e remodelação | JLRM Construções"
  description="Veja obras de construção de moradias e remodelações da JLRM Construções."
  jsonLd={[breadcrumbLd(siteUrl, [{ name: 'Obras', path: '/obras' }])]}
>
  <div class="page-head"><div class="wrap">
    <p class="crumbs"><a href="/">Início</a> / Obras</p>
    <h1>Obras</h1>
    <p class="lead">Construção de moradias e remodelações.</p>
  </div></div>
  <div class="page-body"><div class="wrap">
    <div class="obras-grid">{obras.map((o, i) => <ObraCard obra={o} index={i} />)}</div>
  </div></div>
</Base>
