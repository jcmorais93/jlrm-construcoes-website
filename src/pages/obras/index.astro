---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ObraCard from '../../components/ObraCard.astro';
import { breadcrumbLd } from '../../lib/jsonld';
import { assertNoDemo } from '../../lib/demo';
const obras = await getCollection('obras');
assertNoDemo(obras.some((o) => o.data.demo), '/obras');
const siteUrl = Astro.site!.origin;
---
<Base
  title="Obras de construção e remodelação em Felgueiras | JLRM"
  description="Veja obras de construção de moradias e remodelações da JLRM Construções em Felgueiras."
  jsonLd={[breadcrumbLd(siteUrl, [{ name: 'Obras', path: '/obras' }])]}
>
  <section>
    <div class="wrap">
      <h1>Obras</h1>
      <p class="lead">Construção de moradias e remodelações.</p>
      <div class="grid">{obras.map((o) => <ObraCard obra={o} />)}</div>
    </div>
  </section>
</Base>
