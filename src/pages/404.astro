---
import Base from '../layouts/Base.astro';
---
<Base title="Página não encontrada | JLRM Construções" description="A página que procura não existe ou foi movida.">
  <div class="page-head"><div class="wrap">
    <p class="label">Erro 404</p>
    <h1 style="margin-top:1rem">Página não encontrada</h1>
    <p class="lead">O endereço que abriu não existe ou foi movido.</p>
    <div class="actions"><a class="btn" href="/">Ir para o início</a><a class="btn secondary" href="/contactos">Contactos</a></div>
  </div></div>
</Base>
