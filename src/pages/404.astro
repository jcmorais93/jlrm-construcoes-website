---
import Base from '../layouts/Base.astro';
---
<Base title="Página não encontrada | JLRM Construções" description="A página que procura não existe ou foi movida.">
  <section>
    <div class="wrap">
      <h1>Página não encontrada</h1>
      <p class="lead">O endereço que abriu não existe ou foi movido.</p>
      <div class="actions">
        <a class="btn" href="/">Ir para o início</a>
        <a class="btn secondary" href="/contactos">Contactos</a>
      </div>
    </div>
  </section>
</Base>
