---
import { u, siteRoot } from '../lib/url';
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../config/site';
import { organizationLd, breadcrumbLd } from '../lib/jsonld';
const siteUrl = siteRoot(Astro.site!);
const { contact } = site;
const a = contact.address;
---
<Base
  title="Contactos e pedido de orçamento | JLRM Construções"
  description="Contacte a JLRM Construções, empreiteiro de obras particulares. Peça um orçamento para a sua obra."
  jsonLd={[organizationLd(siteUrl), breadcrumbLd(siteUrl, [{ name: 'Contactos', path: '/contactos' }])]}
>
  <div class="page-head"><div class="wrap">
    <p class="crumbs"><a href={u('/')}>Início</a> / Contactos</p>
    <h1>Contactos</h1>
    <p class="lead">Fale connosco para pedir um orçamento para a sua obra.</p>
  </div></div>
  <div class="page-body"><div class="wrap two">
    <dl class="facts">
      <div><dt>Morada</dt><dd><span class="todo">{a.street}</span>, <span class="todo">{a.postalCode}</span> {a.locality}</dd></div>
      <div><dt>Telefone</dt><dd>{contact.phoneHref ? <a href={contact.phoneHref}>{contact.phone}</a> : <span class="todo">{contact.phone}</span>}</dd></div>
      <div><dt>Email</dt><dd><span class="todo">{contact.email}</span></dd></div>
    </dl>
    <div>
      <h2>Pedir orçamento</h2>
      <div style="margin-top:1.25rem"><ContactForm /></div>
    </div>
  </div></div>
</Base>
