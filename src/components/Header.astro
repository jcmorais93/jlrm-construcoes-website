---
import { site, nav } from '../config/site';
const path = Astro.url.pathname.replace(/(\/index)?(\.html)?\/?$/, '') || '/';
---
<header class="site">
  <div class="wrap">
    <a class="brand" href="/">{site.shortName}</a>
    <nav aria-label="Principal">
      <ul>
        {nav.map((i) => (
          <li><a href={i.href} aria-current={path === i.href ? 'page' : undefined}>{i.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
