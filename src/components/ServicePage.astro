---
import { u, siteRoot } from '../lib/url';
import Base from '../layouts/Base.astro';
import { breadcrumbLd } from '../lib/jsonld';
import { site } from '../config/site';
interface Props { title: string; description: string; h1: string; slug: string; name: string; }
const { title, description, h1, slug, name } = Astro.props;
const siteUrl = siteRoot(Astro.site!);
const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name,
  serviceType: name,
  provider: { '@type': 'GeneralContractor', name: site.name, url: siteUrl },
  url: `${siteUrl}/servicos/${slug}`,
};
---
<Base title={title} description={description}
  jsonLd={[breadcrumbLd(siteUrl, [{ name: 'Serviços', path: '/servicos' }, { name, path: `/servicos/${slug}` }]), service]}>
  <div class="page-head"><div class="wrap">
    <p class="crumbs"><a href={u('/')}>Início</a> / <a href={u('/servicos')}>Serviços</a> / {name}</p>
    <h1>{h1}</h1>
  </div></div>
  <div class="page-body"><div class="wrap">
    <div class="prose"><slot /></div>
    <div class="actions">
      <a class="btn" href={u('/contactos')}>Pedir orçamento</a>
      <a class="btn secondary" href={u('/obras')}>Ver obras</a>
    </div>
  </div></div>
</Base>
